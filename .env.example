# ဒီဖိုင်ကို  .env  အမည်ပြောင်းပြီး key အစစ်ကို ထည့်ပါ။  (.env ကို GitHub သို့ မတင်ပါနှင့်၊ chat ထဲလည်း မပို့ပါနှင့်)
# မှတ်ချက် (#) များကို စာကြောင်းအသီးသီးမှာ ထားပါ။

# ---- Google AI Studio key (Recap script၊ Gemini TTS၊ Voice Clone) ----
GEMINI_API_KEY=your-key-here

# Google Cloud Text-to-Speech (Chirp 3 HD) သုံးမှသာ ထည့်ပါ
GOOGLE_TTS_API_KEY=your-key-here

# ---- Gemini model (အမည်ကို Google AI Studio မှာ စစ်ပါ - မကြာခဏ ပြောင်းတတ်သည်) ----
GEMINI_MODEL=gemini-flash-latest
# 503/504 (Google ပြည့်နေ) ဖြစ်လျှင် အလိုအလျောက် ပြောင်းသုံးမည့် model (မထည့်လည်းရ)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# ဗီဒီယိုကို Gemini ဆီ မပို့ဘဲ စာသားသက်သက်သုံးလိုလျှင် 0
GEMINI_USE_VIDEO=0

# ---- အရန် AI provider (Gemini ပြည့်နေ/quota ကုန်/error ဖြစ်လျှင် error ဖြစ်သည့်နေရာကပင် အလိုအလျောက် ပြောင်းသုံး) ----
# key ထည့်ထားသော provider များကို ဒီအစဉ်အတိုင်း စမ်းသည် (စာသားသက်သက်သာ - ဗီဒီယိုကို Gemini သာ မြင်နိုင်)
LLM_FALLBACK=openai
# ANTHROPIC_API_KEY=your-key-here
# ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_OPENAI_API_KEY=your-key-here
# (မဖြစ်မနေ ထည့်ရ - provider ၏ လက်ရှိ model အမည်)
LLM_OPENAI_MODEL=llama-3.1-8b-instant
LLM_OPENAI_BASE_URL=https://api.groq.com/v1     (OpenRouter / Groq / DeepSeek စသည်ဖြင့်လည်း ပြောင်းနိုင်)

# ---- Gemini ကို ထိန်းပို့ခြင်း (429/503 မဖြစ်စေရန်) ----
# တစ်မိနစ်လျှင် request အများဆုံး (0 = မထိန်း)
GEMINI_RPM=20
# Gemini မရဖြစ်ပြီးနောက် အရန်ဆီ တိုက်ရိုက်ပို့မည့် စက္ကန့်
# GEMINI_COOLDOWN_SECONDS=120

# ---- အကောင့် / လုံခြုံရေး ----
# email link များအတွက် ကိုယ့် website လိပ်စာ (online တင်လျှင် https://your-domain.com)
APP_BASE_URL=http://127.0.0.1:8000
# HTTPS သုံးလျှင် 1 (cookie ကို HTTPS တွင်သာ ပို့)
COOKIE_SECURE=0
# Nginx စသည့် proxy နောက်က run လျှင် 1
TRUST_PROXY=0
REQUIRE_EMAIL_VERIFICATION=1
SIGNUP_ENABLED=1
# ထုတ်ပြီးဗီဒီယိုကို ဒီနာရီပြည့်လျှင် အလိုအလျောက်ဖျက်
RETENTION_HOURS=48
# user တစ်ဦး တစ်ပြိုင်နက် တန်းစီ/run ခွင့်ပြုအရေအတွက်
MAX_ACTIVE_JOBS_PER_USER=2

# Google Login ("Continue with Google") - https://console.cloud.google.com > APIs & Services > Credentials
# OAuth client ID (Web application) ဖန်တီးပြီး Authorized redirect URI ၌ APP_BASE_URL + /api/auth/google/callback ကို ထည့်ပါ
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
# မထည့်လျှင် APP_BASE_URL + /api/auth/google/callback
# GOOGLE_REDIRECT_URI=
# OAuth state cookie sign လုပ်ရန် ရှည်ရှည် random စာကြောင်း (python -c "import secrets; print(secrets.token_urlsafe(48))")
# SESSION_SECRET=

# Background music (Openverse API) - key မလိုပါ (anonymous: တစ်မိနစ် ~၂၀ ကြိမ်)
# https://api.openverse.org/v1/#tag/auth အရ client ID/secret ယူထည့်လျှင် limit မြင့်သည်
# MUSIC_ENABLED=1
# MUSIC_LICENSES=cc0,pdm,by
# OPENVERSE_CLIENT_ID=
# OPENVERSE_CLIENT_SECRET=

# Email ပို့ရန် (SMTP) - မထည့်လျှင် dev mode: link များကို terminal ထဲမှာသာ ပြ (ကိုယ့်စက်စမ်းရန်)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Movie Recap <no-reply@example.com>
# SMTP_SECURITY=starttls

# Google reCAPTCHA v2 ("I'm not a robot") - site key နှင့် secret ကို https://www.google.com/recaptcha/admin မှ ရယူ
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET=

# ---- Speech-to-Text (စကား -> စာသား) ----
# local  = ကိုယ့်စက်မှာ faster-whisper run (GPU/CPU လို၊ requirements-local.txt သွင်းရ)
# groq | openai = API သုံး (GPU မလို - online server အတွက် အကြံပြု)
TRANSCRIBE_BACKEND=local
GROQ_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# (မထည့်ရင် groq=whisper-large-v3-turbo၊ openai=whisper-1)
TRANSCRIBE_MODEL=whisper-large-v3-turbo
# TRANSCRIBE_CHUNK_SECONDS=600
# TRANSCRIBE_CONCURRENCY=2

# ---- Whisper (local backend သုံးမှသာ) ----
# tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# auto | cpu | cuda   (GPU မရှိလျှင် auto သို့ cpu)
WHISPER_DEVICE=auto
# WHISPER_LANGUAGE=

# ---- TTS ----
TTS_CONCURRENCY=3
TTS_MIN_INTERVAL=0.6

# ---- အခြား ----
MAX_UPLOAD_MB=2048
# Hugging Face model ဒေါင်းလုဒ်တွင် I/O error ဖြစ်လျှင်
# HF_HUB_DISABLE_XET=1
